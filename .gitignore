# Environments and Secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.crt
*.pfx
*.p12

# Composer Dependencies
/vendor/

# Runtime and Writable Storage
/writable/logs/*
!/writable/logs/.gitkeep
/writable/session/*
!/writable/session/.gitkeep
/writable/cache/*
!/writable/cache/.gitkeep
/writable/debugbar/*
!/writable/debugbar/.gitkeep
/writable/tmp/*
!/writable/tmp/.gitkeep
/writable/uploads/*
!/writable/uploads/.gitkeep
/writable/pfcentral_backup/*
!/writable/pfcentral_backup/.gitkeep
/writable/backups/*
/writable/database/*.sqlite

# Testing & Coverage
.phpunit.result.cache
/tests/coverage/*
/build/

# IDE and OS
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Archives
*.zip
*.7z
*.tar.gz
*.rar
