# --------------------------------------------------------------------
# pfCentral — Environment Configuration Template
# Copy this file to '.env' and adjust the values for your environment.
# NEVER commit the actual '.env' file containing real secrets to git.
# --------------------------------------------------------------------

# --------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------
# Set to 'production' for live deployments or 'development' for debugging
CI_ENVIRONMENT = production

# --------------------------------------------------------------------
# APP SETTINGS
# --------------------------------------------------------------------
app.baseURL = 'http://localhost:8080'
app.forceGlobalSecureRequests = false
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'pfcentral_session'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = true
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false

# Security
app.CSPEnabled = false

# Timezone
app.appTimezone = 'UTC'

# Encryption Key - Generate using: php spark key:generate
encryption.key = 

# --------------------------------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = pfcentral
database.default.username = pfcentral_user
database.default.password = change_this_to_a_secure_password
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# SQLite alternative (uncomment if using SQLite):
# database.default.DBDriver = SQLite3
# database.default.database = writable/database/pfcentral.sqlite

# --------------------------------------------------------------------
# PFCENTRAL AGENT & BACKUP SETTINGS
# --------------------------------------------------------------------
# Master directory for storing encrypted pfSense configuration XML snapshots
PFCENTRAL_BACKUP_DIR = 'writable/pfcentral_backup'

# Shared secret token for WireGuard uptime telemetry (optional)
PFCENTRAL_WG_TELEMETRY_TOKEN = 'generate_a_random_shared_token_here'

# --------------------------------------------------------------------
# ACTIVE DIRECTORY / LDAP AUTHENTICATION (OPTIONAL)
# --------------------------------------------------------------------
AD_ENABLE = false
AD_HOST = 'ldap://ad.example.local'
AD_PORT = 389
AD_DOMAIN = 'example.local'
AD_NETBIOS = 'CORP'
AD_FALLBACK_LOCAL = true

# --------------------------------------------------------------------
# LIBRENMS & MONITORING INTEGRATION (OPTIONAL)
# --------------------------------------------------------------------
LIBRENMS_API_URL = ''
LIBRENMS_API_TOKEN = ''
LIBRENMS_SNMP_COMMUNITY = 'public'
LIBRENMS_SNMP_VERSION = 'v2c'

# --------------------------------------------------------------------
# SMTP / EMAIL NOTIFICATIONS (OPTIONAL)
# --------------------------------------------------------------------
email.fromEmail = 'noreply@example.com'
email.fromName = 'pfCentral Notifications'
email.protocol = 'smtp'
email.SMTPHost = 'smtp.example.com'
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
